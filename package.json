{
  "name": "fitpulse",
  "version": "1.0.0",
  "private": true,
  "description": "FitPulse - MERN fitness tracker (workouts, nutrition, progress, analytics, community)",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "NODE_ENV=production node server.js",
    "server": "node --watch server.js",
    "client": "vite --config client/vite.config.js",
    "build": "vite build --config client/vite.config.js",
    "seed": "node server/seed.js",
    "seed:reset": "node server/seed.js --reset",
    "test": "MONGODB_URI=mongodb://127.0.0.1:27017 node --test --test-force-exit tests/",
    "backup": "bash scripts/backup.sh"
  },
  "dependencies": {
    "express": "^5.1.0",
    "mongodb": "^6.19.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "playwright": "^1.65.1",
    "vite": "^5.4.20"
  }
}
